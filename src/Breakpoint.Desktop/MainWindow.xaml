<Window x:Class="Breakpoint.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="Breakpoint" Width="820" Height="560" MinWidth="560" MinHeight="460" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowStyle="None"
  Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="46"/><Setter Property="Width" Value="46"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
  </Window.Resources>
  <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
            <Canvas Width="20" Height="20" Margin="0,0,10,0"><Path Data="M5,1 L11,1 L6,17 L0,17 Z M12,7 L18,7 L15,17 L9,17 Z" Fill="{DynamicResource Accent}"/></Canvas>
            <TextBlock Text="breakpoint" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="MinimizeWindow" AutomationProperties.Name="Minimize settings to tray"/><Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="CloseWindow" AutomationProperties.Name="Close settings to tray"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12,22,12,14">
          <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,18,0,0"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Dim}" Margin="0,0,8,0"/><TextBlock Text="PIN protected" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
            <StackPanel>
              <Button x:Name="ScheduleNav" Style="{StaticResource NavButton}" Click="ScheduleTab"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Schedule" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
              <Button x:Name="TimerNav" Style="{StaticResource NavButton}" Click="TimerTab"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Timer" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
              <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsTab"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Settings" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
          <StackPanel Margin="32,28,32,24">
            <StackPanel x:Name="SchedulePanel">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="A time to switch off." FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="EnabledLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="12" Margin="12,0,0,0" Text="● Curfew off"/></Grid>
              <TextBlock Text="Your evening boundary, handled quietly." Style="{StaticResource Muted}" Margin="0,8,0,26"/>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Evening curfew" FontSize="13"/><TextBlock x:Name="DaysSummary" Text="Every day" Grid.Column="1" Style="{StaticResource Muted}"/></Grid>
                  <Grid Margin="0,25,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="START" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><TextBlock x:Name="StartDisplay" FontSize="27"><Run Text="10:00"/><Run Text=" PM" FontSize="12" Foreground="{DynamicResource Dim}"/></TextBlock></StackPanel>
                    <TextBlock Grid.Column="1" Text="–" FontSize="24" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="2"><TextBlock Text="END" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><TextBlock x:Name="EndDisplay" FontSize="27"><Run Text="6:00"/><Run Text=" AM" FontSize="12" Foreground="{DynamicResource Dim}"/></TextBlock></StackPanel>
                  </Grid>
                  <WrapPanel x:Name="Weekdays"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,24"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Dim}" Margin="0,3,10,0"/><TextBlock Text="A one-minute warning before shutdown.&#x0a;Skipping a curfew requires your owner PIN." Style="{StaticResource Muted}" LineHeight="21"/></StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="PreviewWarning" FontFamily="Segoe UI" Click="TestWarning" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Dim}" Padding="8,10"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Test warning" Foreground="{DynamicResource Dim}"/></StackPanel></Button>
                <Button Grid.Column="1" Content="Edit schedule · PIN" Click="SaveSchedule"/>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="TimerPanel" Visibility="Collapsed"><TextBlock Text="Set a stopping point." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="The earlier deadline wins. Your recurring schedule stays enabled." Style="{StaticResource Muted}" Margin="0,10,0,26"/><TextBlock Text="Minutes until curfew"/><TextBox x:Name="TimerMinutes" Text="60" Margin="0,8,0,18" AutomationProperties.Name="Minutes until curfew" MaxLength="4"/><WrapPanel><Button Content="Start timer · PIN" Click="StartTimer" Style="{StaticResource Primary}" Margin="0,0,10,10"/><Button Content="Cancel timer · PIN" Click="CancelTimer" Margin="0,0,0,10"/></WrapPanel><TextBlock x:Name="TimerStatus" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><TextBlock Text="Quietly in control." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Background behavior and owner access." Style="{StaticResource Muted}" Margin="0,10,0,20"/><CheckBox x:Name="ShowIsland" Content="Show floating island" IsChecked="True" Checked="IslandVisibilityChanged" Unchecked="IslandVisibilityChanged"/><CheckBox x:Name="WarningSound" Content="Play warning sound" IsChecked="True"/><CheckBox x:Name="LightTheme" Content="Light appearance" Checked="ThemeChanged" Unchecked="ThemeChanged"/><TextBlock Text="Closing settings returns to the tray. Enabled schedules keep running in the background." Style="{StaticResource Muted}" Margin="0,14,0,22"/><WrapPanel><Button x:Name="SetupButton" Content="Set up owner PIN" Click="SetupOwner" Margin="0,0,10,10"/><Button Content="Change PIN" Click="ChangePin" Margin="0,0,10,10"/><Button Content="Recover PIN" Click="RecoverPin" Margin="0,0,0,10"/></WrapPanel><TextBlock Text="The owner PIN protects Breakpoint controls. A Windows administrator can stop or uninstall the service." Style="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,9"><StackPanel><TextBlock x:Name="ModeLabel" Style="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="StatusLabel" Text="Connecting…" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource Warning}" Margin="0,3,0,0" FontSize="12" Visibility="Collapsed"/></StackPanel></Border>
    </Grid>
  </Border>
</Window>
